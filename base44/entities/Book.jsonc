{
  "name": "Book",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Book title"
    },
    "subtitle": {
      "type": "string",
      "description": "Book subtitle"
    },
    "seriesName": {
      "type": "string",
      "description": "Series name if part of a series"
    },
    "seriesNumber": {
      "type": "number",
      "description": "Volume number in the series"
    },
    "edition_number": {
      "type": "string",
      "description": "Edition number"
    },
    "authorFirstName": {
      "type": "string",
      "description": "Author first name"
    },
    "authorLastName": {
      "type": "string",
      "description": "Author last name"
    },
    "author_name": {
      "type": "string",
      "description": "Full author name (combined)"
    },
    "contributors": {
      "type": "array",
      "description": "Additional contributors",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "description": {
      "type": "string",
      "description": "Book description / blurb"
    },
    "language": {
      "type": "string",
      "description": "Primary language"
    },
    "keywords": {
      "type": "array",
      "description": "Up to 7 search keywords",
      "items": {
        "type": "string"
      }
    },
    "categories": {
      "type": "array",
      "description": "Up to 3 browse categories",
      "items": {
        "type": "string"
      }
    },
    "sexually_explicit": {
      "type": "boolean",
      "description": "Contains sexually explicit content"
    },
    "readingAgeMin": {
      "type": "string",
      "description": "Minimum reading age"
    },
    "readingAgeMax": {
      "type": "string",
      "description": "Maximum reading age"
    },
    "primary_marketplace": {
      "type": "string",
      "description": "Primary marketplace for sales",
      "default": "classpedia.ai"
    },
    "preorderType": {
      "type": "string",
      "enum": [
        "release_now",
        "preorder"
      ],
      "default": "release_now",
      "description": "Release now or make available for pre-order"
    },
    "preorderDate": {
      "type": "string",
      "format": "date",
      "description": "Pre-order release date"
    },
    "publication_date": {
      "type": "string",
      "format": "date",
      "description": "Publication date"
    },
    "isbn": {
      "type": "string",
      "description": "ISBN number"
    },
    "drm": {
      "type": "boolean",
      "description": "Digital Rights Management enabled"
    },
    "ai_generated": {
      "type": "boolean",
      "description": "Whether AI tools were used in creating the content"
    },
    "manuscript_url": {
      "type": "string",
      "description": "Uploaded manuscript file URL"
    },
    "manuscript_filename": {
      "type": "string",
      "description": "Original manuscript filename"
    },
    "sample_url": {
      "type": "string",
      "description": "Uploaded sample chapter file URL"
    },
    "sample_filename": {
      "type": "string",
      "description": "Original sample chapter filename"
    },
    "cover_url": {
      "type": "string",
      "description": "Book cover image URL"
    },
    "classpedia_select": {
      "type": "boolean",
      "description": "Enrolled in Classpedia Select program"
    },
    "royalty_plan": {
      "type": "string",
      "enum": [
        "35",
        "70"
      ],
      "description": "Royalty percentage plan"
    },
    "list_price": {
      "type": "number",
      "description": "List price in USD"
    },
    "currency": {
      "type": "string",
      "description": "Price currency"
    },
    "territories": {
      "type": "string",
      "enum": [
        "worldwide",
        "specific"
      ],
      "description": "Distribution territories"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "published",
        "unpublished"
      ],
      "default": "draft",
      "description": "Publishing status"
    }
  },
  "required": [
    "title",
    "author_name",
    "description",
    "language"
  ]
}