{
  "name": "Review",
  "type": "object",
  "properties": {
    "book_id": {
      "type": "string",
      "description": "ID of the book being reviewed"
    },
    "book_title": {
      "type": "string",
      "description": "Title of the book (denormalized for display)"
    },
    "reviewer_name": {
      "type": "string",
      "description": "Name of the reviewer"
    },
    "reviewer_email": {
      "type": "string",
      "description": "Email of the reviewer"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Star rating (1-5)"
    },
    "comment": {
      "type": "string",
      "description": "Review comment text"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "hidden",
        "flagged"
      ],
      "default": "published",
      "description": "Review visibility status"
    },
    "author_response": {
      "type": "string",
      "description": "Author's response to the review"
    },
    "helpful_count": {
      "type": "number",
      "default": 0,
      "description": "Number of users who found this review helpful"
    },
    "verified_purchase": {
      "type": "boolean",
      "default": false,
      "description": "Whether the reviewer purchased the book"
    }
  },
  "required": [
    "book_id",
    "book_title",
    "rating",
    "comment"
  ]
}